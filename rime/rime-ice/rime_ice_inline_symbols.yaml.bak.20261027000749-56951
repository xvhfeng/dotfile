# 拼音内嵌符号增强。
# 由 rime_ice.custom.yaml 引入；请勿复制到上游 rime_ice.schema.yaml。
patch:
  # 在 key_binder 之前截获按键，避免「,」「.」被默认翻页快捷键抢走。
  engine/processors/@before 3: lua_processor@inline_symbol

  # 保留上游所有标点映射，只把以下符号变为可选择的候选项。
  # 空输入时由 lua/inline_symbol.lua 直接提交每项的第一个符号。
  punctuator/full_shape:
    __include: default:/punctuator/full_shape
    ',' : [ '，', ',', '、' ]
    '.' : [ '。', '.', '…' ]
    '/' : [ '／', '/', '÷' ]
    ';' : [ '；', ';' ]
    ':' : [ '：', ':' ]
    '?' : [ '？', '?' ]
    '!' : [ '！', '!' ]
    '@' : [ '＠', '@', '☯' ]
    '#' : [ '＃', '#', '⌘' ]
    '%' : [ '％', '%', '°', '℃' ]
    '*' : [ '＊', '*', '·', '・', '×', '※' ]
    '+' : [ '＋', '+' ]
    '\\' : [ '、', '\\' ]
    '|' : [ '·', '|', '｜', '§' ]

  punctuator/half_shape:
    __include: default:/punctuator/half_shape
    ',' : [ '，', ',', '、' ]
    '.' : [ '。', '.', '…' ]
    '/' : [ '/', '／', '÷' ]
    ';' : [ '；', ';' ]
    ':' : [ '：', ':' ]
    '?' : [ '？', '?' ]
    '!' : [ '！', '!' ]
    '@' : [ '@', '＠', '☯' ]
    '#' : [ '#', '＃', '⌘' ]
    '%' : [ '%', '％', '°', '℃' ]
    '*' : [ '*', '＊', '·', '・', '×', '※' ]
    '+' : [ '+', '＋' ]
    '\\' : [ '、', '\\' ]
    '|' : [ '|', '·', '｜', '§' ]
