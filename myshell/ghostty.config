# ==========================================
# 字体配置 (Font)
# ==========================================
language = zh_CN
fullscreen = true

font-family = "JetBrainsMono Nerd Font"
font-size = 15
font-thicken = true

# ==========================================
# 主题与外观 (Theme & Window)
# ==========================================
# 内置主题名称（可通过 ghostty +list-themes 查看所有可用主题）
 theme = JetBrains Islands Dark

# 窗口透明度与模糊（macOS 效果极佳）
background-opacity = 0.92
background-blur = true

# 窗口内边距
window-padding-x = 12
window-padding-y = 12

# 窗口装饰：隐藏原生标题栏，使用更现代的沉浸式外观
window-decoration = true
gtk-titlebar = false

# 光标样式
cursor-style = block
cursor-style-blink = false

# ==========================================
# 行为与性能 (Behavior & Performance)
# ==========================================
# 确认关闭窗口（防止误触）
confirm-close-surface = false

# 复制时自动去除尾部空格
copy-on-select = true

# 鼠标隐藏（打字时自动隐藏鼠标指针）
mouse-hide-while-typing = true

# 滚动回溯行数
scrollback-limit = 10000

# ==========================================
# 快捷键绑定 (Keybindings)
# ==========================================
# 绑定一些常用的窗口或标签页操作（可按需自定义）
keybind = ctrl+shift+n=new_window
# keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface